# Reinicorn local state (not committed)
.reinicorn/mode
.reinicorn/skillset-lock.json

# Adapter-installed skills (rcorn skills install) — only native skills are tracked.
.agents/skills/*
!.agents/skills/using-reinicorn/
!.agents/skills/populate-agents-md/
# Generated by the installed adapter's wiring doc into a tracked native skill
# dir — the negation above re-includes the dir, so this needs its own rule.
.agents/skills/using-reinicorn/references/skillset-wiring.md

# Personal Claude Code settings (per-user, never shared)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
src/reinicorn/_version.py

# Build artifacts
dist/
build/

# Test caches
.pytest_cache/

# Coverage reports
.coverage
coverage.xml
htmlcov/

# Local git worktrees
.worktrees/
kb/
