# Reinicorn local state (not committed)
.reinicorn/mode

# Adapter-installed skills (rcorn skills install) — only native skills are
# tracked. The lockfile (.reinicorn/skillset-lock.json) and the wiring doc
# it determines ARE committed: they record which adapter this repo uses, and
# `rcorn skills install` (no argument), `rcorn update`, `rcorn init`, and the
# post-checkout hook restore the ignored files from that lock.
.agents/skills/*
!.agents/skills/using-reinicorn/
!.agents/skills/populate-agents-md/

# Personal Claude Code settings (per-user, never shared)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
src/reinicorn/_version.py

# Build artifacts
dist/
build/

# Test caches
.pytest_cache/

# Coverage reports
.coverage
coverage.xml
htmlcov/

# Local git worktrees
.worktrees/
kb/
